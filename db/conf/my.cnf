[mysqld]
# --- Port non standard (sécurité) ---
port                      = 6033

# --- Compatibilité PMB ---
sql_mode                  = NO_AUTO_CREATE_USER
default_storage_engine    = InnoDB
max_allowed_packet        = 64M

# --- Encodage (utf8 requis par l'installeur PMB 7.4.x) ---
character_set_server      = utf8
collation_server          = utf8_unicode_ci

# --- Performance (ajuster selon la RAM disponible) ---
innodb_buffer_pool_size   = 1G
key_buffer_size           = 1G
join_buffer_size          = 4M
tmp_table_size            = 64M
max_heap_table_size       = 64M

# --- Connexions ---
max_connections           = 150
wait_timeout              = 300
interactive_timeout       = 300
connect_timeout           = 10
open_files_limit          = 50000

# --- Sécurité ---
local_infile              = 0
skip_symbolic_links       = 1

# --- Logs ---
slow_query_log            = 1
slow_query_log_file       = /var/lib/mysql/slow-queries.log
long_query_time           = 2

# --- Bind (écoute sur toutes les interfaces du réseau Docker) ---
bind_address              = 0.0.0.0

[client]
port                      = 6033
